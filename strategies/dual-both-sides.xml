<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="nextSideId" islocal="false" iscloud="false">Next Side</variable>
    <variable type="" id="takeProfitId" islocal="false" iscloud="false">Take Profit</variable>
    <variable type="" id="stopLossId" islocal="false" iscloud="false">Stop Loss</variable>
    <variable type="" id="totalProfitId" islocal="false" iscloud="false">Total Profit</variable>
  </variables>
  <block type="trade_definition" id="dualTradeDef" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="dualMarket" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="dualTradeType" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="dualContractType" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="dualCandle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="dualRestartBuy" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="dualRestartErr" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="initNextSide">
        <field name="VAR" id="nextSideId" variabletype="">Next Side</field>
        <value name="VALUE">
          <block type="math_number" id="initNextSideNum">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="initTakeProfit">
            <field name="VAR" id="takeProfitId" variabletype="">Take Profit</field>
            <value name="VALUE">
              <block type="math_number" id="initTakeProfitNum">
                <field name="NUM">10</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="initStopLoss">
                <field name="VAR" id="stopLossId" variabletype="">Stop Loss</field>
                <value name="VALUE">
                  <block type="math_number" id="initStopLossNum">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="notify" id="initNotify">
                    <field name="NOTIFICATION_TYPE">info</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <shadow type="text">
                        <field name="TEXT">abc</field>
                      </shadow>
                      <block type="text" id="initNotifyText">
                        <field name="TEXT">Dual-side bot: buys both contracts of the selected pair back-to-back. Change trade type in block 1, then set Purchase A and Purchase B.</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="dualTradeOptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="dualDuration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="dualStake">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="dualDuring" x="780" y="0">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if" id="dualDuringIf">
        <value name="IF0">
          <block type="check_sell" id="dualCheckSell"></block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="dualAfter" x="780" y="248">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="setTotalProfit">
        <field name="VAR" id="totalProfitId" variabletype="">Total Profit</field>
        <value name="VALUE">
          <block type="total_profit" id="readTotalProfit"></block>
        </value>
        <next>
          <block type="notify" id="notifyProfit">
            <field name="NOTIFICATION_TYPE">info</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <shadow type="text">
                <field name="TEXT">abc</field>
              </shadow>
              <block type="text_join" id="profitJoin">
                <mutation items="2"></mutation>
                <value name="ADD0">
                  <block type="text" id="profitLabel">
                    <field name="TEXT">Total profit: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="variables_get" id="profitVal">
                    <field name="VAR" id="totalProfitId" variabletype="">Total Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="ifFinishPair">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmpSideOne">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get" id="getSideAfter">
                        <field name="VAR" id="nextSideId" variabletype="">Next Side</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="numOneAfter">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="setSideTwo">
                    <field name="VAR" id="nextSideId" variabletype="">Next Side</field>
                    <value name="VALUE">
                      <block type="math_number" id="numTwoSet">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                    <next>
                      <block type="trade_again" id="tradeAgainSideB"></block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="variables_set" id="setSideOne">
                    <field name="VAR" id="nextSideId" variabletype="">Next Side</field>
                    <value name="VALUE">
                      <block type="math_number" id="numOneSet">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <block type="controls_if" id="ifContinue">
                        <value name="IF0">
                          <block type="logic_operation" id="andLimits">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="logic_compare" id="cmpTp">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get" id="getTpProfit">
                                    <field name="VAR" id="totalProfitId" variabletype="">Total Profit</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="getTp">
                                    <field name="VAR" id="takeProfitId" variabletype="">Take Profit</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_compare" id="cmpSl">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_get" id="getSlProfit">
                                    <field name="VAR" id="totalProfitId" variabletype="">Total Profit</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_arithmetic" id="negSl">
                                    <field name="OP">MINUS</field>
                                    <value name="A">
                                      <block type="math_number" id="zeroSl">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get" id="getSl">
                                        <field name="VAR" id="stopLossId" variabletype="">Stop Loss</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="trade_again" id="tradeAgainNextPair"></block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="dualBefore" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="ifPurchaseSide">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="cmpBuySide">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="getSideBuy">
                <field name="VAR" id="nextSideId" variabletype="">Next Side</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="numOneBuy">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchaseSideA">
            <field name="PURCHASE_LIST">DIGITEVEN</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="purchaseSideB">
            <field name="PURCHASE_LIST">DIGITODD</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
