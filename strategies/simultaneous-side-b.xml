<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="takeProfitB" islocal="false" iscloud="false">Take Profit</variable>
    <variable type="" id="stopLossB" islocal="false" iscloud="false">Stop Loss</variable>
    <variable type="" id="totalProfitB" islocal="false" iscloud="false">Total Profit</variable>
  </variables>
  <block type="trade_definition" id="sideBTradeDef" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="sideBMarket" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="sideBTradeType" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="sideBContractType" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="sideBCandle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="sideBRestartBuy" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="sideBRestartErr" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="initTpB">
        <field name="VAR" id="takeProfitB" variabletype="">Take Profit</field>
        <value name="VALUE">
          <block type="math_number" id="initTpBNum">
            <field name="NUM">10</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="initSlB">
            <field name="VAR" id="stopLossB" variabletype="">Stop Loss</field>
            <value name="VALUE">
              <block type="math_number" id="initSlBNum">
                <field name="NUM">10</field>
              </block>
            </value>
            <next>
              <block type="notify" id="notifyB">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text">
                    <field name="TEXT">abc</field>
                  </shadow>
                  <block type="text" id="notifyBText">
                    <field name="TEXT">Tab B: Odd (or Fall / Lower / Low Tick). Run together with simultaneous-side-a.xml.</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="sideBOptions">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number_positive">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="sideBDuring" x="780" y="0">
    <statement name="DURING_PURCHASE_STACK">
      <block type="controls_if">
        <value name="IF0">
          <block type="check_sell"></block>
        </value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="sideBAfter" x="780" y="248">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="setProfitB">
        <field name="VAR" id="totalProfitB" variabletype="">Total Profit</field>
        <value name="VALUE">
          <block type="total_profit"></block>
        </value>
        <next>
          <block type="controls_if" id="ifContinueB">
            <value name="IF0">
              <block type="logic_operation">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="totalProfitB" variabletype="">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get">
                        <field name="VAR" id="takeProfitB" variabletype="">Take Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="totalProfitB" variabletype="">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_arithmetic">
                        <field name="OP">MINUS</field>
                        <value name="A">
                          <block type="math_number">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get">
                            <field name="VAR" id="stopLossB" variabletype="">Stop Loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="sideBBefore" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchaseB">
        <field name="PURCHASE_LIST">DIGITODD</field>
      </block>
    </statement>
  </block>
</xml>
