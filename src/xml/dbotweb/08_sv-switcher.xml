<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="sv_stake">Stake</variable>
    <variable id="sv_initialStake">initialStake</variable>
    <variable id="sv_martingale">Martingale</variable>
    <variable id="sv_over_prediction">over prediction</variable>
    <variable id="sv_under_prediction">under prediction</variable>
    <variable id="sv_loss_count">lossCount</variable>
  </variables>
  <block type="trade_definition" id="sv_trade_def" deletable="false" x="0" y="60">
    <field name="PARAM_LABEL">NONE</field>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="sv_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="sv_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="sv_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="sv_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="sv_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="sv_restarterror" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="sv_set_stake">
        <field name="VAR" id="sv_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="sv_stake_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="sv_set_initial">
            <field name="VAR" id="sv_initialStake">initialStake</field>
            <value name="VALUE">
              <block type="math_number" id="sv_initial_val">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="sv_set_martingale">
                <field name="VAR" id="sv_martingale">Martingale</field>
                <value name="VALUE">
                  <block type="math_number" id="sv_martingale_val">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="sv_set_over">
                    <field name="VAR" id="sv_over_prediction">over prediction</field>
                    <value name="VALUE">
                      <block type="math_number" id="sv_over_val">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="sv_set_under">
                        <field name="VAR" id="sv_under_prediction">under prediction</field>
                        <value name="VALUE">
                          <block type="math_number" id="sv_under_val">
                            <field name="NUM">8</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="sv_set_loss_count">
                            <field name="VAR" id="sv_loss_count">lossCount</field>
                            <value name="VALUE">
                              <block type="math_number" id="sv_loss_count_val">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="sv_tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number" id="sv_dur_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="math_number" id="sv_dur_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="sv_amt_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="sv_amt_var">
            <field name="VAR" id="sv_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="sv_pred_shadow">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="sv_pred_var">
            <field name="VAR" id="sv_over_prediction">over prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="sv_before_purchase" deletable="false" x="0" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="strategy_sv_switcher_apply" id="sv_switcher_apply">
        <value name="OVER_PREDICTION">
          <block type="variables_get" id="sv_get_over">
            <field name="VAR" id="sv_over_prediction">over prediction</field>
          </block>
        </value>
        <value name="UNDER_PREDICTION">
          <block type="variables_get" id="sv_get_under">
            <field name="VAR" id="sv_under_prediction">under prediction</field>
          </block>
        </value>
        <next>
          <block type="purchase" id="sv_purchase">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="sv_after_purchase" x="720" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="sv_win_check">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="sv_check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="sv_win_reset_stake">
            <field name="VAR" id="sv_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="sv_win_initial_get">
                <field name="VAR" id="sv_initialStake">initialStake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="sv_win_reset_loss_count">
                <field name="VAR" id="sv_loss_count">lossCount</field>
                <value name="VALUE">
                  <block type="math_number" id="sv_win_loss_zero">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="sv_loss_double_stake">
            <field name="VAR" id="sv_stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="sv_loss_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="sv_mult_a_shadow">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="sv_mult_stake_get">
                    <field name="VAR" id="sv_stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="sv_mult_b_shadow">
                    <field name="NUM">2</field>
                  </shadow>
                  <block type="variables_get" id="sv_mult_martingale_get">
                    <field name="VAR" id="sv_martingale">Martingale</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="sv_loss_inc_count">
                <field name="VAR" id="sv_loss_count">lossCount</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="sv_loss_count_plus">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <shadow type="math_number" id="sv_loss_count_a">
                        <field name="NUM">0</field>
                      </shadow>
                      <block type="variables_get" id="sv_loss_count_get">
                        <field name="VAR" id="sv_loss_count">lossCount</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="sv_loss_count_b">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="sv_trade_again"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
